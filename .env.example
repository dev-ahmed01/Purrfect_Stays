NODE_ENV=development

# API
API_PORT=4000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=128kb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access-secret
JWT_ACCESS_TTL=15m
JWT_ISSUER=purrfect-api
JWT_AUDIENCE=purrfect-web
REFRESH_TOKEN_TTL=30d
REFRESH_COOKIE_NAME=purrfect_refresh
BOOKING_TAX_RATE_BPS=1200

# Database
DATABASE_URL=postgresql://purrfect:purrfect@localhost:5432/purrfect_stays?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Web
# Browser-facing API. In production Vercel use /api/v1 so auth cookies remain first-party.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-side API origin used by Next.js server components.
API_INTERNAL_URL=http://localhost:4000/api/v1
# Origin only; Next.js rewrites /api/v1/* here in production.
API_PROXY_ORIGIN=http://localhost:4000

# Local seed only — choose your own value; never commit the real password
SEED_DEMO_PASSWORD=
