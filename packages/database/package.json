{
  "name": "@purrfect/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push --skip-generate",
    "dev": "prisma generate && tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "prisma": "^6.16.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "@types/node": "^24.3.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
